        <!-- EC2 → S3 Artifact (GetObject app.zip, via S3 GW endpoint) -->
        <mxCell id="e_ec2_s3art" edge="1" parent="1" source="ec2a" target="s3_art" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;fontSize=9;fontColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="s3:GetObject (app.zip)">
          <mxGeometry relative="1" as="geometry">
