        <mxCell id="cw" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;html=1;fillColor=#E7157B;strokeColor=#ffffff;labelBackgroundColor=none;fontColor=#232F3E;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;" value="&lt;b&gt;CloudWatch Alarms&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;ASG CPU high &gt; 40% / low &lt; 20%&lt;br&gt;ALB 5xx &gt; 50/min&lt;br&gt;RDS CPU &gt; 80%  ·  Storage &lt; 2 GiB&lt;/font&gt;" vertex="1">
          <mxGeometry x="1130" y="870" w="60" h="60" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════
             EDGES — Traffic flows
        ═══════════════════════════════════════════════════════════════ -->

        <!-- Internet → CloudFront (user HTTPS traffic) -->
        <mxCell id="e_inet_cf" edge="1" parent="1" source="internet" target="cf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0080F0;fontSize=9;fontColor=#0080F0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Route 53 → CloudFront (DNS A-alias) -->
        <mxCell id="e_r53_cf" edge="1" parent="1" source="r53" target="cf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#9673a6;dashed=1;fontSize=9;fontColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="A-alias">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CloudFront → WAF (attached, same ACL) -->
        <mxCell id="e_cf_waf" edge="1" parent="1" source="cf" target="waf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#DD344C;dashed=1;fontSize=9;fontColor=#DD344C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="WAF attached">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ACM CF cert → CloudFront (TLS) -->
        <mxCell id="e_acmcf_cf" edge="1" parent="1" source="acm_cf" target="cf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#b85450;dashed=1;fontSize=9;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="TLS cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Internet → Cognito (OAuth redirect for Hosted UI login) -->
        <mxCell id="e_inet_cognito" edge="1" parent="1" source="internet" target="cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#9673a6;dashed=1;fontSize=9;fontColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="OAuth redirect (Hosted UI login)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CloudFront → ALB (HTTP:80, dynamic paths) -->
        <mxCell id="e_cf_alb" edge="1" parent="1" source="cf" target="alb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0080F0;fontSize=9;fontColor=#0080F0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="HTTP:80  /admin/* /driver/* /track/* /*">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="270" />
              <mxPoint x="575" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CloudFront → S3 Media (OAC, /static/* /media/*) -->
        <mxCell id="e_cf_s3media" edge="1" parent="1" source="cf" target="s3_media" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#82b366;dashed=1;fontSize=9;fontColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="OAC (SigV4)  /static/* /media/*">
          <mxGeometry relative="1" as="geometry">
