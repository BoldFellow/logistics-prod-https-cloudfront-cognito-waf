          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NAT GW → Internet (EC2 outbound: pip/dnf packages) -->
        <mxCell id="e_nat_inet" edge="1" parent="1" source="nat" target="internet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0080F0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" value="">
