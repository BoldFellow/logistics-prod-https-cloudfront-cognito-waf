        <!-- EC2 → CloudFront CreateInvalidation (after driver photo upload) -->
        <mxCell id="e_ec2_cf_inv" edge="1" parent="1" source="ec2b" target="cf" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#FF8000;fontSize=9;fontColor=#FF8000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="CreateInvalidation (/track/*)">
