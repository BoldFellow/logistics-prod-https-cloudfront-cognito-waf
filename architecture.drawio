              <mxPoint x="1250" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- EC2 → Cognito (JWKS endpoint — JWT validation, outbound via NAT) -->
        <mxCell id="e_ec2_cognito" edge="1" parent="1" source="ec2b" target="cognito" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;fontSize=9;fontColor=#9673a6;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="JWKS (JWT validation)">
          <mxGeometry relative="1" as="geometry">
